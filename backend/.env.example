# Firebase Admin SDK credentials
# Create a service account in your Firebase project and provide the path to the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase Web App credentials
# These can be found in your Firebase project's web app settings.
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_DATABASE_URL=your_firebase_database_url
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# Google Drive Configuration
# The ID of the Google Drive folder where images should be stored.
# You can find this in the URL of the folder: https://drive.google.com/drive/folders/YOUR_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
